{
  "phase": 4,
  "name": "Dicionário único de estados, cores e severidades",
  "canonicalStates": [
    { "state": "neutral", "color": "neutral", "decision": "observe" },
    { "state": "action", "color": "blue", "decision": "act" },
    { "state": "healthy", "color": "green", "decision": "observe" },
    { "state": "attention", "color": "amber", "decision": "review" },
    { "state": "critical", "color": "rose", "decision": "act_now" },
    { "state": "blocked", "color": "rose", "decision": "unblock" },
