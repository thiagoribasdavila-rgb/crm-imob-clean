{
  "phase": 32,
  "program": "meta-andromeda-automation",
  "sourcePhase": 31,
  "environment": "local_ephemeral_pg17",
  "approval": {
    "required": true,
    "exactValue": "EXECUTE_PHASE32_PG17_LOCAL_EPHEMERAL_ONLY"
  },
  "sourceEvidence": {
    "phase30RuntimeEvidenceRequired": true,
    "phase31ReconciliationRequired": true,
    "sharedArtifactFingerprintsMustMatch": true
  },
  "runtime": {
    "engine": "docker_compose",
    "composeFile": "infra/meta-phase32/compose.pg17.yaml",
    "postgresImage": "supabase/postgres:17.6.1.149",
    "postgresMajor": 17,
    "host": "127.0.0.1",
    "port": 55433,
    "database": "atlas_phase32",
    "user": "postgres",
    "volume": "phase32-pg17-postgres-data",
    "reusesPg15Volume": false,
    "linkedProject": false,
    "remoteTarget": false,
    "productionTarget": false,
    "destroyVolumesAfterRun": true
  },
  "extensionCompatibility": {
    "allowedRequiredExtensions": ["pgcrypto"],
    "blockedOnPg17": ["timescaledb", "plv8", "plcoffee", "plls"]
