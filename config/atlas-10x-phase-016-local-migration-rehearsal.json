{
  "schema_version": "atlas.10x.phase-016.v1",
  "phase": 16,
  "total_phases": 24,
  "name": "Ensaio local governado da migration",
  "objective": "Validar uma única migration aprovada em PostgreSQL 17 local, com reset reproduzível, pgTAP, lint, advisors, comparação de superfície e evidência sanitizada antes de qualquer promoção.",
  "status": "local_rehearsal_contract_ready_inputs_blocked",
  "build_policy": "build_only_on_release_package",
  "input_contract": {
    "phase_015_config_path": "config/atlas-10x-phase-015-isolated-migration-package.json",
    "phase_015_evidence_path": "artifacts/runtime/phase-015/isolated-migration-package-evidence.json",
    "phase_015_manifest_path": "artifacts/runtime/phase-015/execution/isolated-migration-package.json",
    "phase_016_permit_path": "artifacts/runtime/phase-016/manual/local-migration-rehearsal-permit.json",
    "phase_016_review_path": "artifacts/runtime/phase-016/manual/local-migration-review.json",
    "supabase_config_path": "supabase/config.toml",
    "required_manifest_schema_version": "atlas.isolated_migration_package.v1",
    "required_permit_schema_version": "atlas.local_migration_rehearsal_permit.v1",
    "required_review_schema_version": "atlas.local_migration_review.v1",
    "required_permit_status": "approved_for_single_local_rehearsal",
    "required_scope": "isolated_loopback_pg17_only",
    "expected_postgres_major": 17,
    "expected_cli_version": "2.109.1"
  },
  "permit_contract": {
    "one_shot_required": true,
    "issued_at_required": true,
    "expires_at_required": true,
    "maximum_validity_minutes": 60,
    "approved_by_must_be_opaque": true,
    "change_ticket_required": true,
    "manifest_sha256_required": true,
    "migration_sha256_required": true,
    "dynamic_test_sha256_required": true,
    "review_sha256_required": true,
    "target_fingerprint_sha256_required": true,
    "batch_sequence_required": true,
    "permit_does_not_authorize_remote_apply": true
  },
  "artifact_contract": {
    "migration_root": "supabase/migrations",
    "migration_path_pattern": "^supabase/migrations/[0-9]{14}_[a-z0-9_]+\\.sql$",
    "dynamic_test_root": "supabase/tests/database",
    "dynamic_test_path_pattern": "^supabase/tests/database/phase_016_[a-z0-9_]+\\.test\\.sql$",
    "migration_review_root": "artifacts/runtime/phase-016/manual",
    "migration_must_be_scaffolded_with_cli": true,
    "migration_business_dml_allowed": false,
    "migration_auth_user_access_allowed": false,
    "test_synthetic_fixture_dml_allowed": true,
    "test_must_always_rollback": true,
    "raw_cli_output_persisted": false,
    "database_url_persisted": false,
    "fixture_identifiers_persisted": false
  },
  "sql_review_contract": {
    "exact_object_allowlist_required": true,
    "every_changed_object_mapped_to_finding": true,
    "every_finding_mapped_to_changed_object": true,
    "transaction_required": true,
    "lock_timeout_required": true,
    "statement_timeout_required": true,
    "preconditions_required": true,
    "postconditions_required": true,
    "idempotency_review_required": true,
    "rls_and_grants_reviewed_separately": true,
    "update_policy_requires_select_using_with_check": true,
    "views_require_security_invoker_or_no_api_exposure": true,
    "security_definer_requires_fixed_search_path_and_minimal_execute": true,
    "user_metadata_authorization_forbidden": true,
    "auth_role_policy_helper_forbidden": true,
    "unsafe_rollback_forbidden": true
  },
  "cli_contract": {
    "local_cli_path": "./node_modules/.bin/supabase",
    "isolated_home_path": ".tmp/supabase-home",
    "commands": [
      "supabase db reset --local --no-seed",
      "supabase migration list --local",
      "supabase test db <approved_test_path> --local",
      "supabase db lint --local --level warning --fail-on error",
      "supabase db advisors --local --type security --level info --fail-on warn",
      "supabase db advisors --local --type performance --level warn --fail-on error"
    ],
    "forbidden_tokens": [
      "--linked",
      "--db-url",
      "supabase db push",
      "supabase db pull",
      "supabase migration repair",
      "apply_migration",
      "execute_sql"
    ],
    "remote_commands_allowed": false,
    "network_access_required": false,
    "local_stack_start_allowed_only_after_all_preflight_gates": true
  },
  "rehearsal_contract": {
    "single_batch_per_run": true,
    "clean_reset_without_seed_required": true,
    "migration_history_check_required": true,
    "postgres_major_assertion_required": true,
    "positive_rls_paths_required": true,
    "cross_tenant_denials_required": true,
    "anonymous_denials_required": true,
    "grants_verified_separately_from_rls": true,
    "catalog_delta_matches_exact_allowlist": true,
    "local_lint_required": true,
    "security_advisor_required": true,
    "performance_advisor_required": true,
    "second_clean_reset_required": true,
    "second_dynamic_test_required": true,
    "idempotency_proof_required": true,
    "human_review_after_rehearsal_required": true
  },
  "required_preflight_gates": [
    "phase_015_manifest_exists",
    "phase_015_manifest_parses",
    "manifest_schema_version_matches",
    "phase_015_evidence_accepts_package",
    "manifest_scope_is_local_pg17",
    "manifest_contains_exactly_one_selected_batch",
    "permit_exists",
    "permit_parses",
    "permit_schema_version_matches",
    "permit_status_matches",
    "permit_scope_is_local_only",
    "permit_is_one_shot",
    "permit_identity_is_opaque",
    "permit_change_ticket_is_present",
    "permit_window_is_valid",
    "permit_postgres_major_matches",
    "permit_cli_version_matches",
    "permit_manifest_hash_matches",
    "permit_batch_matches_manifest",
    "migration_path_is_safe",
    "migration_exists",
    "migration_hash_matches",
    "dynamic_test_path_is_safe",
    "dynamic_test_exists",
    "dynamic_test_hash_matches",
    "review_path_is_safe",
    "review_exists",
    "review_parses",
    "review_hash_matches",
    "review_schema_version_matches",
    "review_status_is_approved",
    "review_manifest_hash_matches",
    "review_migration_hash_matches",
    "review_test_hash_matches",
    "review_object_allowlist_matches",
    "review_finding_mapping_is_complete",
    "review_security_invariants_pass",
    "migration_static_safety_passes",
    "dynamic_test_static_safety_passes",
    "supabase_config_exists",
    "local_cli_version_matches",
    "cli_plan_is_local_only",
    "remote_or_linked_command_not_used",
    "local_database_not_started",
    "migration_not_applied",
    "business_or_auth_data_not_read",
    "live_homologation_not_touched",
    "build_not_executed",
    "package_not_created"
  ],
  "execution_policy": {
    "allows_local_artifact_read": true,
    "allows_local_cli_help": true,
    "allows_static_sql_review": true,
    "allows_local_database_start_after_all_gates": true,
    "allows_local_database_reset_after_all_gates": true,
    "allows_synthetic_transactional_test_data_after_all_gates": true,
    "allows_remote_metadata_read": false,
    "allows_remote_schema_read": false,
    "allows_remote_ddl": false,
    "allows_remote_dml": false,
    "allows_linked_project": false,
    "allows_database_url": false,
    "allows_auth_user_read": false,
    "allows_business_data_read": false,
    "allows_build": false,
    "allows_release_package": false
  },
  "next_phase": "Fase 17/24: após um ensaio local aprovado e repetível, produzir o dossiê de decisão para homologação sem aplicar DDL remoto automaticamente."
}
