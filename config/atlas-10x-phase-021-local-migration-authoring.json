    "phase_020_specification_has_no_sql_or_object_names",
    "phase_020_specification_authorizes_no_action",
    "authorization_exists",
    "authorization_parses",
    "authorization_schema_matches",
    "authorization_status_matches",
    "authorization_scope_matches",
    "authorization_is_one_shot_and_unused",
    "authorization_window_is_valid",
    "authorization_reviewer_is_present",
    "authorization_change_ticket_is_present",
    "authorization_specification_hash_matches",
    "authorization_baseline_hash_is_sha256",
    "authorization_migration_name_matches",
    "authorization_allows_only_local_authoring",
    "cli_version_is_supported",
    "cli_commands_are_exact",
    "cli_commands_are_local_only",
    "forbidden_cli_tokens_absent",
    "migration_directory_is_confined",
    "test_directory_is_confined",
    "existing_migrations_are_immutable",
    "manifest_is_generated_in_memory",
    "manifest_schema_matches",
    "manifest_status_matches",
    "manifest_source_shape_is_exact",
    "manifest_source_hashes_match",
    "manifest_cli_shape_is_exact",
    "manifest_cli_commands_match",
    "manifest_migration_shape_is_exact",
    "manifest_migration_is_single_and_unapplied",
    "manifest_requires_rollback",
    "manifest_rollback_shape_is_exact",
    "manifest_negative_tests_are_exact",
    "manifest_covers_anonymous_crud_denials",
    "manifest_covers_cross_tenant_crud_denials",
    "manifest_covers_owned_row_crud",
    "manifest_blocks_tenant_reassignment",
    "manifest_couples_data_api_grants_and_rls",
    "manifest_covers_view_and_function_boundaries",
    "manifest_keeps_service_secret_out_of_client",
    "manifest_contains_no_credentials_or_rows",
    "manifest_authorizes_no_remote_or_apply_action",
    "remote_command_not_executed",
    "migration_not_generated_or_applied",
    "linked_project_not_accessed",
    "production_not_touched",
    "business_or_auth_data_not_read",
    "build_not_executed",
    "package_not_created"
  ],
  "execution_policy": {
    "this_evaluator_executes_commands": false,
    "this_evaluator_writes_files": false,
    "allows_manifest_in_memory": true,
    "allows_local_sql_authoring_after_gate": true,
    "allows_local_migration_generation_after_gate": true,
    "allows_local_pgtap_authoring_after_gate": true,
    "allows_local_test_and_lint_after_gate": true,
    "allows_remote_read": false,
    "allows_remote_write": false,
    "allows_linked_project": false,
    "allows_migration_apply": false,
    "allows_db_push": false,
    "allows_migration_repair": false,
    "allows_branch_mutation": false,
    "allows_production": false,
    "allows_business_data_read": false,
    "allows_auth_user_read": false,
    "allows_storage_object_read": false,
    "allows_build": false,
    "allows_release_package": false
  },
  "official_references": [
    "https://supabase.com/docs/reference/cli/supabase-start",
    "https://supabase.com/docs/guides/local-development/cli-workflows",
