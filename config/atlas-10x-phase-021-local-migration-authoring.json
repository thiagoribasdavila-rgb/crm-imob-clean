{
  "schema_version": "atlas.10x.phase-021.v1",
  "phase": 21,
  "total_phases": 24,
  "name": "Gate de autoria local de migrations Supabase",
  "objective": "Preparar uma autorização determinística, local e fail-closed para criar uma migration nomeada pelo Supabase CLI somente depois de uma especificação real da Fase 20 e aprovação humana vinculada por SHA-256, sem aplicar migration, acessar projeto linked, ler dados, tocar produção, executar build ou gerar ZIP.",
  "status": "local_migration_authoring_contract_ready_phase_020_specification_and_human_authorization_required",
  "build_policy": "build_only_on_release_package",
  "cli_contract": {
    "required_version": "2.109.1",
    "migration_new_tokens": [
      "supabase",
      "migration",
      "new",
      "atlas_security_remediation"
    ],
    "test_db_tokens": [
      "supabase",
      "test",
      "db",
      "--local"
    ],
    "db_lint_tokens": [
      "supabase",
      "db",
      "lint",
      "--local",
      "--level",
      "error"
    ],
    "forbidden_tokens": [
      "--linked",
      "db push",
      "migration repair",
      "production",
      "main"
    ],
    "migration_directory": "supabase/migrations",
    "test_directory": "supabase/tests",
    "existing_migrations_must_remain_immutable": true
  },
  "input_contract": {
    "authorization_path": "artifacts/runtime/phase-021/manual/local-migration-authorization.json",
    "required_specification_schema_version": "atlas.local_remediation_specification.v1",
    "required_specification_status": "local_specifications_ready_for_human_authoring",
    "required_authorization_schema_version": "atlas.local_migration_authorization.v1",
    "required_authorization_status": "approved_for_single_local_migration_authoring",
    "required_authorization_scope": "phase_020_approved_workstreams_only",
    "authorization_ttl_minutes": 30
  },
  "authorization_contract": {
    "required_fields": [
      "schema_version",
      "status",
      "scope",
      "one_shot",
      "consumed",
      "issued_at",
      "expires_at",
      "reviewed_by",
      "change_ticket",
      "specification_sha256",
      "baseline_manifest_sha256",
      "migration_name",
      "authorizations"
    ],
    "required_authorization_fields": [
      "local_sql_authoring",
      "local_migration_generation",
      "local_pgtap_authoring",
      "local_test_execution",
      "local_lint_execution",
      "remote_read",
      "remote_write",
      "linked_project",
      "migration_apply",
      "db_push",
      "migration_repair",
      "branch_mutation",
      "production",
      "business_rows_read",
      "auth_rows_read",
      "storage_objects_read",
      "build",
      "release_package"
    ],
    "migration_name": "atlas_security_remediation",
    "requires_human_reviewer": true,
    "requires_change_ticket": true,
    "requires_one_shot": true,
    "credentials_forbidden": true,
    "personal_data_forbidden": true,
    "business_data_forbidden": true,
    "auth_user_data_forbidden": true,
    "raw_cli_output_forbidden": true
  },
  "authoring_manifest_contract": {
    "schema_version": "atlas.local_migration_authoring_manifest.v1",
    "ready_status": "ready_for_single_local_cli_authoring",
    "required_root_fields": [
      "schema_version",
      "status",
      "source",
      "cli",
      "migration",
      "rollback",
      "negative_tests",
      "privacy",
      "authorizations"
    ],
    "required_source_fields": [
      "specification_sha256",
      "authorization_sha256",
      "baseline_manifest_sha256"
    ],
    "required_cli_fields": [
      "version",
      "migration_new_tokens",
      "test_db_tokens",
      "db_lint_tokens"
    ],
    "required_migration_fields": [
      "name",
      "directory",
      "existing_files_immutable",
      "new_files_expected",
      "generated_by_this_evaluator",
      "applied"
    ],
    "required_rollback_fields": [
      "required",
      "human_review_required",
      "data_loss_forbidden",
      "restore_point_required",
      "verification_required"
    ],
    "required_privacy_fields": [
      "contains_credentials",
      "contains_personal_data",
      "contains_business_data",
      "contains_auth_user_data",
      "contains_raw_cli_output"
    ],
    "required_authorization_fields": [
      "remote_read",
      "remote_write",
      "linked_project",
      "migration_apply",
      "db_push",
      "migration_repair",
      "branch_mutation",
      "production",
      "business_rows_read",
      "auth_rows_read",
      "storage_objects_read",
      "build",
      "release_package"
    ]
  },
  "negative_test_catalog": [
    "anonymous_select_denied",
    "anonymous_insert_denied",
    "anonymous_update_denied",
    "anonymous_delete_denied",
    "cross_tenant_select_denied",
