  "name": "Gate de ensaio local descartável de migration Supabase",
  "objective": "Preparar um ensaio determinístico, descartável e fail-closed da única migration autorizada na Fase 21, com pgTAP, lint local, restauração por reconstrução limpa e prova de cleanup, sem iniciar Docker nesta avaliação, sem acessar projeto linked, sem ler dados reais, sem tocar produção, sem build e sem ZIP.",
  "status": "local_rehearsal_contract_ready_phase_021_receipt_and_human_authorization_required",
  "build_policy": "build_only_on_release_package",
  "input_contract": {
    "authoring_receipt_path": "artifacts/runtime/phase-021/manual/local-migration-authoring-receipt.json",
