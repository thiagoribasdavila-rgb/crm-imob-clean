  "cli_contract": {
    "required_version": "2.109.1",
    "workdir": ".atlas/runtime/phase-022/rehearsal",
    "project_id": "atlas-phase-022-rehearsal",
    "migration_directory": "supabase/migrations",
    "test_directory": "supabase/tests",
    "migration_name": "atlas_security_remediation",
    "test_file_name": "atlas_security_remediation_test.sql",
    "commands": {
      "db_start": [
        "supabase",
        "db",
        "start",
        "--workdir",
        ".atlas/runtime/phase-022/rehearsal"
      ],
      "baseline_reset": [
        "supabase",
        "db",
        "reset",
        "--local",
        "--no-seed",
        "--workdir",
        ".atlas/runtime/phase-022/rehearsal"
      ],
      "migration_up": [
        "supabase",
        "migration",
        "up",
        "--local",
        "--workdir",
        ".atlas/runtime/phase-022/rehearsal"
      ],
      "test_db": [
        "supabase",
        "test",
        "db",
        "--local",
        "supabase/tests/atlas_security_remediation_test.sql",
        "--workdir",
        ".atlas/runtime/phase-022/rehearsal"
      ],
      "db_lint": [
        "supabase",
        "db",
        "lint",
        "--local",
        "--level",
        "error",
        "--fail-on",
        "error",
        "--workdir",
        ".atlas/runtime/phase-022/rehearsal"
      ],
      "rollback_reset": [
        "supabase",
        "db",
        "reset",
        "--local",
        "--no-seed",
        "--workdir",
        ".atlas/runtime/phase-022/rehearsal"
      ],
      "cleanup": [
        "supabase",
        "stop",
        "--project-id",
        "atlas-phase-022-rehearsal",
        "--no-backup",
        "--workdir",
        ".atlas/runtime/phase-022/rehearsal"
      ]
    },
    "command_order": [
      "db_start",
      "baseline_reset",
      "migration_up",
      "test_db",
      "db_lint",
      "rollback_reset",
      "cleanup"
    ],
    "forbidden_tokens": [
      "--linked",
      "--db-url",
      "db push",
      "migration repair",
      "projects list",
      "login",
      "--all",
      "production",
      "main"
    ]
  },
