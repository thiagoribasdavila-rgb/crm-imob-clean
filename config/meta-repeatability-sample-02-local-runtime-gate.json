  },
  "runtime": {
    "engine": "docker_compose",
    "composeFile": "infra/meta-phase30/compose.yaml",
    "postgresImage": "supabase/postgres:15.14.1.149",
    "host": "127.0.0.1",
    "port": 55432,
    "database": "atlas_phase30",
    "user": "postgres",
    "linkedProject": false,
    "remoteTarget": false,
    "productionTarget": false,
