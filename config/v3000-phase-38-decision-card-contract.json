{
  "phase": 38,
  "title": "Contrato único do card de decisão",
  "status": "contract-adopted",
  "businessRuntimeMutationAllowed": false,
  "presentationContractMutationAllowed": true,
  "databaseMutationAllowed": false,
  "previousPhaseRegistry": "config/v3000-phase-37-card-inventory.json",
  "canonicalPrimitive": {
    "file": "components/ui/AtlasCard.tsx",
