    "dossier_schema_matches",
    "dossier_decision_is_preflight_only",
    "dossier_authorizes_preflight_read_only",
    "dossier_does_not_authorize_apply_or_production",
    "dossier_target_identity_is_hash_only",
    "target_descriptor_exists",
    "target_descriptor_parses",
    "target_schema_matches",
    "target_is_homologation",
    "target_is_isolated_branch",
    "target_is_not_production_or_main",
    "target_data_policy_is_safe",
    "target_identity_is_hash_only",
    "target_descriptor_shape_is_exact",
    "target_health_is_preflight_pending",
    "target_contains_no_credentials",
    "dossier_target_matches_descriptor",
    "preflight_permit_exists",
    "preflight_permit_parses",
    "permit_schema_matches",
    "permit_status_is_read_only_preflight",
    "permit_is_one_shot_current_and_unconsumed",
    "permit_reviewer_is_opaque",
    "permit_change_ticket_is_present",
    "permit_hash_bindings_match",
    "permit_scope_is_exact",
    "permit_allows_only_sanitized_remote_reads",
    "permit_forbids_rows_exports_and_raw_output",
    "permit_forbids_all_remote_mutations",
    "preflight_observation_exists",
    "preflight_observation_parses",
    "observation_schema_matches",
    "observation_status_matches",
    "observation_hash_bindings_match",
    "observation_uses_expected_cli_and_postgres",
    "observation_branch_health_is_observed",
    "observation_is_metadata_only",
    "observation_check_shape_is_exact",
    "observation_required_checks_are_captured",
    "observation_count_shape_is_exact",
    "observation_counts_are_nonnegative_integers",
    "observation_fingerprints_are_sha256",
    "observation_permit_was_consumed",
    "observation_is_sanitized",
    "observation_contains_no_rows_or_credentials",
    "observation_performed_no_remote_mutation",
    "production_not_touched",
    "business_or_auth_data_not_read",
    "branch_not_created_merged_or_deleted",
    "migration_not_applied",
    "build_not_executed",
    "package_not_created"
  ],
  "execution_policy": {
    "this_evaluator_executes_remote_commands": false,
    "this_evaluator_writes_files": false,
    "allows_future_one_shot_remote_metadata_read_with_valid_permit": true,
    "allows_future_one_shot_remote_schema_catalog_read_with_valid_permit": true,
    "allows_remote_ddl": false,
    "allows_remote_dml": false,
    "allows_migration_apply": false,
    "allows_db_push": false,
    "allows_migration_repair": false,
    "allows_branch_creation": false,
    "allows_branch_update": false,
    "allows_branch_pause": false,
    "allows_branch_delete": false,
    "allows_branch_merge": false,
    "allows_production": false,
    "allows_real_data_copy": false,
    "allows_business_data_read": false,
    "allows_auth_user_read": false,
    "allows_storage_object_read": false,
    "allows_raw_cli_output_persistence": false,
