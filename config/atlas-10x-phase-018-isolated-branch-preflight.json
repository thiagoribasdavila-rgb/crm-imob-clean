{
  "schema_version": "atlas.10x.phase-018.v1",
  "phase": 18,
  "total_phases": 24,
  "name": "Preflight sanitizado de branch isolada",
  "objective": "Preparar e validar uma observação remota estritamente read-only de uma branch Supabase isolada, sem consultar linhas comerciais ou de autenticação, sem persistir credenciais e sem autorizar migration, DDL, DML, branch mutation, build ou ZIP.",
  "status": "preflight_contract_ready_remote_execution_not_authorized",
  "build_policy": "build_only_on_release_package",
  "input_contract": {
    "phase_017_dossier_path": "artifacts/runtime/phase-017/execution/homologation-decision-dossier.json",
    "target_descriptor_path": "artifacts/runtime/phase-017/manual/homologation-target-descriptor.json",
    "preflight_permit_path": "artifacts/runtime/phase-018/manual/isolated-branch-preflight-permit.json",
    "preflight_observation_path": "artifacts/runtime/phase-018/execution/isolated-branch-preflight-observation.json",
    "required_dossier_schema_version": "atlas.homologation_decision_dossier.v1",
    "required_target_schema_version": "atlas.homologation_target.v1",
