    "required_observation_schema_version": "atlas.isolated_branch_preflight_observation.v1",
    "required_dossier_decision": "approved_for_manual_homologation_preflight_only",
    "required_permit_status": "approved_for_isolated_read_only_preflight",
    "required_observation_status": "isolated_branch_preflight_observed"
  },
  "target_contract": {
    "allowed_target_types": [
      "supabase_preview_branch",
      "supabase_persistent_branch"
    ],
    "required_environment": "homologation",
    "required_initial_health": "preflight_pending",
    "required_observed_health": "preflight_observed",
    "allowed_data_policies": [
      "data_less",
      "synthetic_only"
    ],
    "allowed_descriptor_fields": [
      "schema_version",
      "environment",
      "target_type",
      "isolated_branch",
      "production",
      "main_branch",
      "data_policy",
      "project_ref_sha256",
      "target_fingerprint_sha256",
      "branch_health"
    ],
    "production_target_forbidden": true,
    "main_branch_forbidden": true,
    "raw_project_ref_forbidden": true,
    "api_url_forbidden": true,
    "api_keys_forbidden": true,
    "connection_string_forbidden": true
  },
  "permit_contract": {
    "scope": "isolated_supabase_branch_read_only_metadata_and_catalog",
    "one_shot_required": true,
    "maximum_validity_minutes": 30,
    "reviewer_must_be_opaque": true,
    "change_ticket_required": true,
    "dossier_sha256_required": true,
    "target_descriptor_sha256_required": true,
    "remote_metadata_read_allowed": true,
    "remote_schema_catalog_read_allowed": true,
    "remote_migration_ledger_read_allowed": true,
    "remote_advisor_summary_read_allowed": true,
    "business_rows_read_allowed": false,
    "auth_rows_read_allowed": false,
    "storage_objects_read_allowed": false,
    "raw_cli_output_allowed": false,
    "remote_ddl_allowed": false,
    "remote_dml_allowed": false,
    "migration_apply_allowed": false,
    "db_push_allowed": false,
    "migration_repair_allowed": false,
    "branch_mutation_allowed": false,
    "production_allowed": false,
    "data_export_allowed": false
  },
  "observation_contract": {
    "postgres_major": 17,
    "cli_version": "2.109.1",
    "permit_must_be_consumed": true,
    "metadata_only_required": true,
    "branch_reachability_required": true,
    "branch_isolation_required": true,
    "migration_ledger_summary_required": true,
    "rls_summary_required": true,
    "grant_summary_required": true,
    "update_policy_summary_required": true,
    "view_security_summary_required": true,
    "security_definer_summary_required": true,
    "advisor_summary_required": true,
    "catalog_fingerprint_required": true,
    "migration_ledger_fingerprint_required": true,
    "advisor_fingerprint_required": true,
    "sanitized_counts_only": true,
    "object_names_forbidden": true,
    "raw_sql_forbidden": true,
    "raw_cli_output_forbidden": true,
    "credentials_forbidden": true,
    "personal_data_forbidden": true,
    "business_data_forbidden": true,
    "auth_user_data_forbidden": true
  },
  "allowed_observation_checks": [
    "branch_reachability",
    "branch_isolation",
    "migration_ledger",
    "rls_posture",
    "data_api_grants",
    "update_policy_posture",
    "view_security_posture",
    "security_definer_posture",
    "security_advisors",
    "performance_advisors"
