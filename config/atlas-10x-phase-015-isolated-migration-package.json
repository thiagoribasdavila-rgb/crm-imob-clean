{
  "schema_version": "atlas.10x.phase-015.v1",
  "phase": 15,
  "total_phases": 24,
  "name": "Pacote governado de migration isolada",
  "objective": "Preparar, sem executar, um pacote determinístico de ensaio para achados aprovados do backlog de segurança, com escopo local, precondições, pós-condições e rollback que não reabra exposições.",
  "status": "isolated_migration_contract_ready_approval_blocked",
  "build_policy": "build_only_on_release_package",
  "input_contract": {
    "phase_014_config_path": "config/atlas-10x-phase-014-security-remediation-backlog.json",
    "phase_014_evidence_path": "artifacts/runtime/phase-014/security-remediation-backlog-evidence.json",
    "phase_014_backlog_path": "artifacts/runtime/phase-014/execution/security-remediation-backlog.json",
    "phase_013_snapshot_path": "artifacts/runtime/phase-013/execution/access-surface-snapshot.json",
    "approval_receipt_path": "artifacts/runtime/phase-015/manual/isolated-rehearsal-approval.json",
    "required_backlog_schema_version": "atlas.security_remediation_backlog.v1",
    "required_snapshot_schema_version": "atlas.access_surface_snapshot.v1",
    "required_approval_schema_version": "atlas.isolated_migration_approval.v1",
    "required_approval_status": "approved_for_isolated_rehearsal",
    "required_approval_scope": "isolated_loopback_pg17_only",
    "required_source_kind": "isolated_loopback_pg17",
    "expected_postgres_major": 17
  },
  "approval_contract": {
    "human_approval_required": true,
    "approved_by_must_be_opaque": true,
    "approval_timestamp_required": true,
    "change_ticket_required": true,
    "rollback_review_required": true,
    "backlog_sha256_required": true,
    "snapshot_sha256_required": true,
    "approved_finding_ids_required": true,
    "approval_is_rehearsal_only": true,
    "approval_does_not_authorize_remote_apply": true
  },
  "migration_package_contract": {
    "schema_version": "atlas.isolated_migration_package.v1",
    "manifest_path": "artifacts/runtime/phase-015/execution/isolated-migration-package.json",
    "review_template_path": "scripts/sql/phase-015-isolated-migration-review-template.sql",
    "automatic_file_creation_allowed": false,
    "executable_sql_allowed_before_approval": false,
    "migration_must_be_scaffolded_with_cli": true,
    "one_dependency_stage_per_batch": true,
    "exact_object_allowlist_required": true,
    "transaction_required_when_supported": true,
    "lock_timeout_required": true,
    "statement_timeout_required": true,
    "preconditions_required": true,
    "postconditions_required": true,
    "idempotency_review_required": true,
    "dynamic_rls_tests_required": true,
    "database_advisors_required": true,
    "local_reset_required": true,
    "business_row_dml_allowed": false,
    "auth_user_read_allowed": false,
    "automatic_rollback_allowed": false,
    "rollback_may_not_restore_unsafe_access": true,
    "reversibility_classes": [
      "exact_reversible",
      "containment_only",
      "manual_only"
    ]
  },
  "non_migratable_categories": [
    "CANONICAL_ENTITY_MISSING",
    "INVENTORY_INCOMPLETE"
  ],
  "cli_contract": {
    "local_cli_path": "./node_modules/.bin/supabase",
    "verified_cli_version": "2.109.1",
    "isolated_home_path": ".tmp/supabase-home",
    "allowed_scaffold_command": "supabase migration new <approved_name>",
    "allowed_rehearsal_command": "supabase db reset --local --no-seed",
    "forbidden_tokens": [
      "--linked",
      "--db-url",
      "supabase db push",
      "supabase migration repair",
      "apply_migration"
    ],
    "remote_commands_allowed": false,
    "migration_history_repair_allowed": false
  },
  "required_runtime_gates": [
    "phase_014_backlog_exists",
    "phase_014_backlog_parses",
    "backlog_schema_version_matches",
    "backlog_is_canonical",
    "phase_013_snapshot_exists",
    "phase_013_snapshot_parses",
    "snapshot_schema_version_matches",
    "snapshot_source_is_approved_loopback",
    "snapshot_postgres_major_matches",
    "approval_receipt_exists",
    "approval_receipt_parses",
    "approval_schema_version_matches",
    "approval_status_matches",
    "approval_scope_is_local_only",
    "approval_identity_is_opaque",
    "approval_timestamp_is_valid",
    "change_ticket_is_present",
    "rollback_review_is_present",
    "backlog_hash_matches",
    "snapshot_hash_matches",
    "approved_ids_are_known_and_unique",
    "selected_findings_are_migratable",
    "p0_precedes_p1",
    "dependency_closure_is_complete",
    "exact_object_allowlist_is_derived",
    "reversibility_is_classified",
    "rollback_does_not_reopen_exposure",
    "transaction_and_timeouts_are_required",
    "preconditions_and_postconditions_are_required",
    "dynamic_rls_tests_are_required",
    "database_advisors_are_required",
    "local_cli_contract_is_verified",
    "review_template_is_comment_only",
    "executable_sql_not_generated",
    "migration_file_not_created",
    "remote_or_linked_command_not_used",
    "business_or_auth_data_not_read",
    "live_homologation_not_touched",
    "build_not_executed",
    "package_not_created"
  ],
  "execution_policy": {
    "allows_local_artifact_read": true,
    "allows_local_cli_help": true,
    "allows_manifest_preview_in_memory": true,
    "allows_migration_scaffold": false,
    "allows_local_database_reset": false,
    "allows_remote_metadata_read": false,
    "allows_remote_schema_read": false,
    "allows_remote_ddl": false,
    "allows_remote_dml": false,
    "allows_linked_project": false,
    "allows_auth_user_read": false,
    "allows_business_data_read": false,
    "allows_build": false,
    "allows_release_package": false
  },
  "next_phase": "Fase 16/24: materializar o ensaio somente após snapshot, backlog e recibo aprovados; validar a migration em PostgreSQL 17 local com testes RLS e advisors antes de qualquer promoção."
}
