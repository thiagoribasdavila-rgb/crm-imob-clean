{
  "phase": 37,
  "program": "meta-andromeda-automation",
  "sourcePhase": 36,
  "environment": "offline_evidence_reconciliation",
  "schemaVersion": "phase37.local-restore-reconciliation.v1",
  "maximumInputBytes": 1048576,
  "sourceEvidence": {
    "schemaVersion": "phase36.local-restore-evidence.v1",
    "phase": 36,
    "sourcePhase": 35,
    "status": "approved_local_restore_only",
    "environment": "local_ephemeral_restore",
    "maximumAgeHours": 24,
    "maximumRestoreDurationMs": 1800000,
    "localRestoreApproved": true,
    "stagingMigrationAllowed": false,
    "productionMigrationAllowed": false,
    "productionCompatibilityApproved": false
  },
  "requiredValidationChecks": [
    "backupHashVerified",
    "backupSizeVerified",
    "logicalBackupSafetyApproved",
    "postgresMajorMatches",
    "catalogFingerprintMatches",
    "catalogCountsMatch",
    "securityApproved",
    "authCountsMatch",
    "storageMetadataCountsMatch",
    "migrationCountMatches",
    "restoreDurationWithinLimit",
    "targetDestructionVerified"
  ],
  "requiredOrderedEvents": [
    "isolated_runtime_started",
    "restore_started",
    "restore_completed",
    "post_restore_validation_approved",
    "runtime_and_volumes_destroyed"
  ],
  "requiredMetricFields": [
    "catalogFingerprint",
    "userSchemaCount",
    "tableCount",
    "rlsEnabledTableCount",
    "publicTablesWithoutRls",
    "invalidConstraintCount",
    "authUserCount",
    "storageBucketCount",
    "storageObjectMetadataCount",
    "migrationCount"
  ],
  "requiredSourceChain": {
    "contractSchemaVersion": "phase35.restore-rehearsal-contract.v1",
    "manifestSchemaVersion": "phase35.backup-manifest.v1",
    "backupType": "logical",
    "postgresMajor": 17,
    "postgresImage": "supabase/postgres:17.6.1.149"
  },
  "reconciliationRules": {
    "exactSourceFingerprints": true,
    "exactBackupContentFingerprint": true,
    "exactExpectedMetrics": true,
    "exactActualMetrics": true,
    "timestampsMustBeOrdered": true,
    "eventsMustBeOrderedAndUnique": true,
    "runtimeMustBeNetworkIsolated": true,
    "publishedPortsMustBeDisabled": true,
    "targetMustBeDestroyed": true,
    "publicTablesWithoutRlsMustEqualZero": true,
    "invalidConstraintCountMustEqualZero": true,
    "sensitiveEvidenceRejected": true,
    "dataRowsRejected": true,
    "localApprovalDoesNotAuthorizeMigration": true
  },
  "prohibitedActions": {
    "databaseAccess": true,
    "dockerExecution": true,
    "remoteDatabaseAccess": true,
    "linkedProjectAccess": true,
    "stagingMutation": true,
    "productionMutation": true,
    "supabaseDbPush": true,
    "supabaseDbResetLinked": true,
    "permitReservation": true,
    "permitIssuance": true,
    "permitConsumption": true,
    "realMetaEventDelivery": true,
    "testMetaEventDelivery": true,
    "campaignMutation": true,
    "deployment": true,
    "buildExecution": true
  }
}
