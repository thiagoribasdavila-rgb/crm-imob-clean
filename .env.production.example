# =============================================================================
# ATLAS V3 / ATLAS ONE — ambiente de PRODUÇÃO (Hostinger)
# =============================================================================
# Copie para .env DIRETO NO SERVIDOR e preencha. Nunca por commit, nunca dentro
# do ZIP, nunca em canal de chat. Nenhum valor abaixo é real.
#
# Fonte da verdade dos nomes: config/environment-variables.json (108 variáveis
# catalogadas) — este arquivo lista as de PRODUÇÃO. Se um nome daqui divergir
# de tutoriais genéricos, vale o daqui: é o que o código lê de fato.
#
# Regras:
# - Variável secreta NUNCA usa prefixo NEXT_PUBLIC_ (as NEXT_PUBLIC_* vão para
#   o navegador e são embutidas NO BUILD — mudar depois exige rebuild).
# - Integração opcional sem chave fica DESLIGADA com recusa explícita; o CRM
#   não cai por causa dela. Confira o estado em GET /api/ready → integrations.
# =============================================================================

# ------------------------------------------------------------------ APP -----
NODE_ENV=production
# A porta vem do painel da Hostinger; o next start lê PORT nativamente.
PORT=3000
# URL pública canônica — callbacks de auth, links de e-mail e webhooks derivam dela.
ATLAS_BASE_URL=https://atlasaios.com.br
NEXT_PUBLIC_APP_URL=https://atlasaios.com.br

# Identidade do ambiente (obrigatórias — o preflight valida a coerência entre elas)
ATLAS_ENV=production
ATLAS_ENVIRONMENT_ID=atlas-v3-hostinger-prod
ATLAS_DATABASE_ENVIRONMENT=production
ATLAS_HOSTING_PROVIDER=hostinger

# ------------------------------------------------------------- SUPABASE -----
# ATENÇÃO (risco R-01, docs/continuity/KNOWN_RISKS.md): existem DOIS projetos
# Supabase. Antes de buildar, rode `npm run database:target:check` para provar
# que estas credenciais apontam para o banco que sustenta a aplicação.
NEXT_PUBLIC_SUPABASE_URL=
# Uma das duas chaves públicas (a publishable é o formato novo):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NUNCA exposta ao navegador:
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ------------------------------------------------------------- SEGURANÇA ----
# Protege os workers (outbox, recorrências, lembretes). Gere um valor forte:
#   openssl rand -hex 32
ATLAS_CRON_SECRET=

# ------------------------------------------------------------------ META ----
# Assinatura do webhook (Meta Lead Ads E WhatsApp usam o mesmo app secret):
META_APP_SECRET=
# Token que VOCÊ define e cadastra no painel Meta ao assinar o webhook:
META_WEBHOOK_VERIFY_TOKEN=
# Tokens por finalidade (são três, de propósito — escopos distintos):
META_LEAD_ACCESS_TOKEN=
META_ADS_ACCESS_TOKEN=
META_CONVERSIONS_ACCESS_TOKEN=
# Identificadores da conta:
# PADRÃO apenas: a conta é escolhida por campanha na tela de Marketing, porque
# uma imobiliária costuma ter uma conta por empreendimento.
#
# Precisa ser uma conta que o TOKEN alcança. Se não for, toda chamada volta com
# "(#200) Ad account owner has NOT grant ads_management" — mensagem que manda
# conferir permissões quando o problema é o ID, e leva o diagnóstico para o
# lado errado por semanas.
#
# Confira com:  npm run meta:conta
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_LEAD_FORM_ID=
META_CAPI_DATASET_ID=
# Versão da Graph API (default do código: v23.0)
META_GRAPH_API_VERSION=v23.0
# CAPI de produção fica DESLIGADA até decisão explícita (dry-run primeiro):
ATLAS_META_CAPI_ENABLED=false

# -------------------------------------------------------------- WHATSAPP ----
# O webhook do WhatsApp usa META_APP_SECRET e META_WEBHOOK_VERIFY_TOKEN acima.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Template aprovado usado pela abordagem noturna (nome exato no gerenciador):
WHATSAPP_NIGHTLY_APPROACH_TEMPLATE=
ATLAS_WHATSAPP_NLU_ENABLED=false

# ------------------------------------------------------------------- IA -----
# Chamadas só no backend. Sem a chave, o provedor fica indisponível e o roteador
# usa o próximo da ordem — o CRM continua de pé.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
# Ordem de preferência por classe de tarefa (provedores separados por vírgula):
ATLAS_AI_FAST_PROVIDER_ORDER=qwen,deepseek,openai
ATLAS_AI_REASONING_PROVIDER_ORDER=openai,deepseek,glm,kimi
ATLAS_AI_COMMERCIAL_PROVIDER_ORDER=
# Modelos por variável (nunca fixos no código). Deixe vazio para o default:
ATLAS_AI_FAST_MODEL=
ATLAS_AI_REASONING_MODEL=
ATLAS_ANTHROPIC_MODEL=
ATLAS_CLAUDE_MODEL=
# Tarifa por (provedor/modelo) em US$ POR MILHÃO de tokens. Sem isso, todo
# consumo de IA é gravado com custo NULO e o painel de FinOps mostra zero —
# parecendo saudável quando não é. Rode `npm run ai:pricing:check` para ver
# quais modelos ainda faltam.
#
# Formato: {"provedor/modelo":{"input":N,"output":N,"cachedInput":N}}
# A chave "provedor/*" vale como tarifa padrão daquele provedor.
# Exemplo de ESTRUTURA (os números são ilustrativos — confirme na página de
# preços de cada provedor antes de usar; preço errado é pior que ausente):
#   {"perplexity/sonar":{"input":1,"output":1},"openai/*":{"input":0.15,"output":0.6}}
ATLAS_AI_PRICE_TABLE=

# --------------------------------------------------------- E-MAIL / SMTP ----
# NÃO há cliente SMTP nesta aplicação — e-mail transacional (recuperação de
# senha, convite) sai pelo SMTP configurado NO SUPABASE AUTH (painel do projeto:
# Authentication → SMTP). Não existem variáveis SMTP_* aqui de propósito;
# criar SMTP próprio duplicaria o canal e os templates.

# ------------------------------------------------- STORAGE DE MATERIAIS -----
# Opcional: S3/R2 para materiais de empreendimento. Sem preencher, usa Supabase.
ATLAS_MATERIAL_STORAGE_PROVIDER=
ATLAS_OBJECT_STORAGE_ENDPOINT=
ATLAS_OBJECT_STORAGE_REGION=
ATLAS_OBJECT_STORAGE_BUCKET=
ATLAS_OBJECT_STORAGE_ACCESS_KEY_ID=
ATLAS_OBJECT_STORAGE_SECRET_ACCESS_KEY=
ATLAS_OBJECT_STORAGE_FORCE_PATH_STYLE=

# ------------------------------------------------------ CALENDÁRIO (OAuth) --
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://atlasaios.com.br/api/v1/calendar/google/callback
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=https://atlasaios.com.br/api/v1/calendar/microsoft/callback

# ------------------------------------------------------------ OPERAÇÃO ------
# TTL do cache de identidade nas rotas (ms), opcional:
ATLAS_IDENTITY_CACHE_TTL_MS=
# Habilita configuração de etapas do funil por organização:
ATLAS_PIPELINE_STAGE_SETTINGS_ENABLED=true

# =============================================================================
# O QUE NÃO DEVE EXISTIR EM PRODUÇÃO (não copie do ambiente de teste):
#   ATLAS_BOOTSTRAP_SECRET  — só durante a ativação; remova depois do 1º admin
#   ATLAS_TEST_EMAIL / ATLAS_TEST_PASSWORD — jamais no servidor
#   ATLAS_DEFAULT_ORGANIZATION_ID — proibida em produção (fixa tenant)
#   ATLAS_ALLOW_PUBLIC_ONLY_TEST — afrouxa teste de rotas
# O deploy audita isso: docs/deploy/RUNBOOK_DEPLOY_HOSTINGER.md, passo 0.5.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# PISO DE TENTATIVAS ANTES DE DESCARTAR UMA LEAD
#
# Quantas tentativas de contato (ligação, WhatsApp, e-mail) precisam existir
# antes de a lead poder ir para "Perdido". Ausente ou 0 = SEM TRAVA.
#
# Está em 0 por decisão do dono do produto (2026-07-27): na largada a base é
# importada e o histórico de contato anterior nunca virou evento no CRM — o
# piso não protegeria atendimento nenhum, só impediria de organizar a base.
#
# Ligue em 3 quando a operação estiver em regime e as tentativas passarem a
# nascer dentro do CRM. Aí o piso volta a fazer o que foi desenhado para fazer:
# impedir que uma lead que ninguém alcançou seja descartada como ruim — o que,
# além de apagar o atendimento, ensina a Meta a evitar um público que talvez
# fosse ótimo. O MOTIVO do descarte continua obrigatório de qualquer forma.
#
# ATLAS_TENTATIVAS_MINIMAS=3

# ─────────────────────────────────────────────────────────────────────────────
# PONTE DE WHATSAPP POR CORRETOR (conexão por QR Code)
#
# ATENÇÃO: usa `@whiskeysockets/baileys`, biblioteca NÃO OFICIAL que contraria
# os termos do WhatsApp. Existe risco real de bloqueio do número PESSOAL do
# corretor. Foi uma decisão consciente do dono do produto — o caminho oficial
# (Cloud API) remove o número do aplicativo do celular, o que inviabiliza o uso
# pelos corretores. Deixar estas variáveis em branco desliga a ponte inteira e
# o CRM segue funcionando normalmente.
#
# Instalar no servidor:  npm install @whiskeysockets/baileys qrcode
# Subir:                 pm2 start ecosystem.config.cjs --only atlas-whatsapp-bridge

# Segredo compartilhado entre o CRM e a ponte. Mínimo 16 caracteres.
# Gere com: openssl rand -hex 32
ATLAS_WHATSAPP_BRIDGE_SECRET=

# Onde a ponte escuta. SEMPRE 127.0.0.1 — nunca exponha esta porta à internet.
ATLAS_WHATSAPP_BRIDGE_URL=http://127.0.0.1:8790
ATLAS_WHATSAPP_BRIDGE_PORT=8790

# Onde ficam as credenciais de sessão do WhatsApp. Precisa estar FORA do
# diretório do repositório: são credenciais de acesso total à conta e não podem
# entrar em git, ZIP ou backup de código.
# Sugestão: /var/lib/atlas/whatsapp   (chmod 700, dono do processo)
ATLAS_WHATSAPP_SESSION_DIR=

# Como a ponte alcança o CRM para entregar as mensagens.
ATLAS_CRM_URL=http://127.0.0.1:3000

# Porta da ponte (padrão 8790). Só 127.0.0.1 — nunca exposta à internet.
# ATLAS_WHATSAPP_BRIDGE_PORT=8790
