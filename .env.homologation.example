# Atlas One — modelo seguro do ambiente de homologação
# Copie localmente para .env.local e substitua TODOS os valores replace-with-*.
# Nunca envie .env.local, senhas, service role ou DATABASE_URL ao GitHub, ZIP ou chat.

ATLAS_ENV=homologation
ATLAS_DATABASE_ENVIRONMENT=homologation
ATLAS_HOSTING_PROVIDER=hostinger
ATLAS_ENVIRONMENT_ID=replace-with-unique-homologation-environment-id
ATLAS_BASE_URL=https://replace-with-hostinger-homologation-domain.invalid
NEXT_PUBLIC_APP_URL=https://replace-with-hostinger-homologation-domain.invalid
ATLAS_E2E_BASE_URL=https://replace-with-hostinger-homologation-domain.invalid

# Tenant exclusivo de homologação
ATLAS_DEFAULT_ORGANIZATION_ID=replace-with-dedicated-homologation-tenant-id

# Conta sintética genérica usada pelos smoke tests legados
ATLAS_TEST_EMAIL=replace-with-synthetic-homologation-account
ATLAS_TEST_PASSWORD=replace-with-private-test-password

# Contas sintéticas para validar RBAC de ponta a ponta
ATLAS_E2E_ADMIN_EMAIL=replace-with-admin-homologation-email
ATLAS_E2E_ADMIN_PASSWORD=replace-with-admin-homologation-password
ATLAS_E2E_DIRECTOR_EMAIL=replace-with-director-homologation-email
ATLAS_E2E_DIRECTOR_PASSWORD=replace-with-director-homologation-password
ATLAS_E2E_MANAGER_EMAIL=replace-with-manager-homologation-email
ATLAS_E2E_MANAGER_PASSWORD=replace-with-manager-homologation-password
ATLAS_E2E_BROKER_EMAIL=replace-with-broker-homologation-email
ATLAS_E2E_BROKER_PASSWORD=replace-with-broker-homologation-password

# Supabase: somente URL e publishable key podem ser públicas
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-supabase-project.supabase.invalid
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key

# Segredos exclusivos do servidor Hostinger
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
DATABASE_URL=postgresql://replace-with-private-homologation-connection-string
ATLAS_CRON_SECRET=replace-with-random-cron-secret

# Primeiro acesso — temporária; remova imediatamente após criar o administrador
ATLAS_BOOTSTRAP_SECRET=replace-with-random-bootstrap-secret-minimum-32-characters

# IA: necessária para o teste real dos agentes; a operação continua protegida sem ela
OPENAI_API_KEY=replace-with-server-only-openai-key
